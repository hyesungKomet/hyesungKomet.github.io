---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  /**
   * URL of the same content in the other language (e.g. a translated post).
   * Defaults to the other language's home page.
   */
  altUrl?: string;
};

const LANGS = [
  { code: "ko", label: "KO" },
  { code: "en", label: "EN" },
] as const;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const { altUrl } = Astro.props;
---

<div
  class="flex items-center gap-1 text-sm font-medium"
  role="group"
  aria-label={t.langSwitch.label}
>
  {
    LANGS.map(({ code, label }, index) => (
      <>
        {index > 0 && (
          <span aria-hidden="true" class="text-muted-foreground">
            |
          </span>
        )}
        {code === locale ? (
          <span aria-current="true" class="text-accent px-1">
            {label}
          </span>
        ) : (
          <a
            href={altUrl ?? getRelativeLocaleUrl(code, "")}
            hreflang={code}
            lang={code}
            data-lang-switch={code}
            class="hover:text-accent px-1 opacity-75 hover:opacity-100"
          >
            {label}
          </a>
        )}
      </>
    ))
  }
</div>
