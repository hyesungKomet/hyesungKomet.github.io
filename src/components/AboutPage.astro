---
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

// Shared by /about (ko) and /en/about (en).
// Content: src/content/pages/about.md (ko) and src/content/pages/en/about.md (en).
const pageLocale = Astro.currentLocale ?? config.site.lang;
const about = await getEntry(
  "pages",
  pageLocale === config.site.lang ? "about" : `${pageLocale}/about`
);

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);

const altLangUrl = getRelativeLocaleUrl(
  pageLocale === "ko" ? "en" : "ko",
  "about"
);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header {altLangUrl} />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
